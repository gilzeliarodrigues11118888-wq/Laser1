--==================================================
-- DETECTAR PISTOLA
--==================================================

local function IsPistol(Tool)

    if not Tool
        or not Tool:IsA("Tool") then

        return false
    end

    if Tool:GetAttribute(
        "IsGun"
    ) == true then

        return true
    end

    if Tool:GetAttribute(
        "IsPistol"
    ) == true then

        return true
    end

    local Name =
        string.lower(
            Tool.Name
        )

    local Keywords = {
        "pistol",
        "gun",
        "glock",
        "revolver",
        "deagle",
        "desert",
        "beretta",
        "usp",
        "1911",
        "handgun"
    }

    for _, Word in ipairs(
        Keywords
    ) do

        if string.find(
            Name,
            Word
        ) then

            return true
        end

    end

    if Tool:FindFirstChild(
        "Handle"
    ) then

        return true
    end

    return false
end

--==================================================
-- HANDLE
--==================================================

local function FindHandle(Tool)

    if not Tool then
        return nil
    end

    local Handle =
        Tool:FindFirstChild(
            "Handle"
        )

    if Handle
        and Handle:IsA(
            "BasePart"
        ) then

        return Handle
    end

    for _, Object in ipairs(
        Tool:GetDescendants()
    ) do

        if Object:IsA(
            "BasePart"
        ) then

            return Object
        end

    end

    return nil
end

--==================================================
-- MUZZLE
--==================================================

local function FindMuzzle(Tool)

    if not Tool then
        return nil
    end

    local Names = {
        "muzzle",
        "muzzleattachment",
        "laserpoint",
        "laserattachment"
    }

    for _, Object in ipairs(
        Tool:GetDescendants()
    ) do

        if Object:IsA(
            "Attachment"
        ) then

            local LowerName =
                string.lower(
                    Object.Name
                )

            for _, Name in ipairs(
                Names
            ) do

                if LowerName == Name then
                    return Object
                end

            end

        end

    end

    return nil
end

--==================================================
-- DIREÇÃO DA ARMA
--==================================================

local function CalculateWeaponDirection(
    Tool,
    Handle
)

    if not Handle then

        return Vector3.new(
            0,
            0,
            -1
        )

    end

    local Muzzle =
        FindMuzzle(Tool)

    if Muzzle then

        local Difference =
            Muzzle.WorldPosition
            - Handle.Position

        if Difference.Magnitude
            > 0.01 then

            return Difference.Unit
        end

    end

    local FurthestPart = nil
    local FurthestDistance = 0

    for _, Object in ipairs(
        Tool:GetDescendants()
    ) do

        if Object:IsA(
            "BasePart"
        )
        and Object ~= Handle then

            local LowerName =
                string.lower(
                    Object.Name
                )

            local Ignore =
                string.find(
                    LowerName,
                    "grip"
                )
                or string.find(
                    LowerName,
                    "handle"
                )
                or string.find(
                    LowerName,
                    "mag"
                )
                or string.find(
                    LowerName,
                    "trigger"
                )

            if not Ignore then

                local Distance =
                    (
                        Object.Position
                        - Handle.Position
                    ).Magnitude

                if Distance
                    > FurthestDistance then

                    FurthestDistance =
                        Distance

                    FurthestPart =
                        Object

                end

            end

        end

    end

    if FurthestPart then

        local Difference =
            FurthestPart.Position
            - Handle.Position

        if Difference.Magnitude
            > 0.01 then

            return Difference.Unit
        end

    end

    return Handle.CFrame.LookVector
end

--==================================================
-- AJUSTE DO LASER
--==================================================

local function ApplyLaserAdjustment(
    Direction,
    Handle
)

    if not Handle then
        return Direction
    end

    local RightAngle =
        math.rad(
            LaserRightAngle
        )

    Direction =
        (
            Direction
            * math.cos(
                RightAngle
            )
            +
            Handle.CFrame.RightVector
            * math.sin(
                RightAngle
            )
        ).Unit

    local DownAngle =
        math.rad(
            LaserDownAngle
        )

    Direction =
        (
            Direction
            * math.cos(
                DownAngle
            )
            -
            Handle.CFrame.UpVector
            * math.sin(
                DownAngle
            )
        ).Unit

    return Direction
end

--==================================================
-- POSIÇÃO DO QUADRADO
--==================================================

local function CalculateEmitterPosition(
    Tool,
    Handle,
    Direction
)

    if not Handle then
        return Vector3.zero
    end

    local Muzzle =
        FindMuzzle(Tool)

    local Position

    if Muzzle then

        Position =
            Muzzle.WorldPosition

    else

        Position =
            Handle.Position
            +
            Direction
            *
            (
                Handle.Size.Z / 2
                +
                EmitterForwardOffset
            )

    end

    Position =
        Position
        +
        Direction
        *
        EmitterForwardOffset

    -- DIREITA DO QUADRADO
    Position =
        Position
        +
        Handle.CFrame.RightVector
        *
        EmitterSideOffset

    -- CIMA DO QUADRADO
    Position =
        Position
        +
        Handle.CFrame.UpVector
        *
        EmitterVerticalOffset

    return Position
end

--==================================================
-- CRIAR EMISSOR
--==================================================

local function CreateEmitter(
    Tool,
    Handle,
    Direction
)

    local Position =
        CalculateEmitterPosition(
            Tool,
            Handle,
            Direction
        )

    local Emitter =
        Instance.new("Part")

    Emitter.Name =
        "TacticalEmitter"

    Emitter.Size =
        EmitterSize

    Emitter.Color =
        EmitterColor

    Emitter.Material =
        Enum.Material.SmoothPlastic

    Emitter.Transparency =
        ShowEmitter and 0 or 1

    Emitter.CanCollide = false
    Emitter.CanTouch = false
    Emitter.CanQuery = false
    Emitter.Massless = true
    Emitter.CastShadow = false

    Emitter.CFrame =
        CFrame.lookAt(
            Position,
            Position + Direction
        )

    Emitter.Parent =
        Tool

    local Weld =
        Instance.new("WeldConstraint")

    Weld.Part0 =
        Handle

    Weld.Part1 =
        Emitter

    Weld.Parent =
        Emitter

    --==================================================
    -- ATTACHMENT CENTRAL
    --==================================================

    local Attachment =
        Instance.new("Attachment")

    Attachment.Name =
        "EmitterFront"

    Attachment.Position =
        Vector3.new(
            0,
            0,
            -EmitterSize.Z / 2
        )

    Attachment.Parent =
        Emitter

    --==================================================
    -- ATTACHMENT VERDE
    -- ESQUERDA
    --==================================================

    local GreenAttachment =
        Instance.new("Attachment")

    GreenAttachment.Name =
        "GreenBeamAttachment"

    GreenAttachment.Position =
        Vector3.new(
            -DualBeamSideOffset,
            0,
            -EmitterSize.Z / 2
        )

    GreenAttachment.Parent =
        Emitter

    --==================================================
    -- ATTACHMENT ROXO
    -- DIREITA
    --==================================================

    local PurpleAttachment =
        Instance.new("Attachment")

    PurpleAttachment.Name =
        "PurpleBeamAttachment"

    PurpleAttachment.Position =
        Vector3.new(
            DualBeamSideOffset,
            0,
            -EmitterSize.Z / 2
        )

    PurpleAttachment.Parent =
        Emitter

    return
        Emitter,
        Attachment,
        GreenAttachment,
        PurpleAttachment
end

